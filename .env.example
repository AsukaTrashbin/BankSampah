# Salin file ini menjadi .env lalu sesuaikan nilainya.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# WAJIB di production. Gunakan string acak minimal 32 karakter.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Set true hanya jika situs dilayani lewat HTTPS.
COOKIE_SECURE=false

# Lokasi file data user (di luar folder publik).
USERS_FILE=server/data/users.json

# Biaya bcrypt. 12 untuk production, 4-10 untuk pengujian lokal.
BCRYPT_ROUNDS=12

# Batas percobaan (per IP, per 15 menit).
LOGIN_RATE_LIMIT_MAX=10
FORGOT_RATE_LIMIT_MAX=5

# SMTP opsional. Jika kosong, link reset dicetak di console saat development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
